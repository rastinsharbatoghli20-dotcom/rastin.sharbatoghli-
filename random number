import random
# the computer chooses a random number between 1 and 1000

secret_number = random.randint(1,1000)

# maximum number of attempts
max_attempts = 9

print("welcome to the guessing game!")
print("i chose a number between 1 and 1000!")
print("you have 9 1chances to guess the number\n")

# loop for 9 attempts
for attempt in range(1,max_attempts+1):
# get the user,s guess
       guess = int(input(f"attempt {attempt}: enter your guess:"))
       #check the user,s guess
       if guess == secret_number:
           print("\nyou WON!")
           print("hello world")
           break

       elif guess > secret_number:
           print("you guessed too high\n")
       else:
           print("you guessed too low\n")

# this runs only if the user did not guess the number
else:
    print("* you LOST! *")
    print("the correct number was",secret_number)
